RewriteEngine On

# =====================================================
# 1. HTTP → HTTPS
# =====================================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://roder.com.pl/$1 [R=301,L]

# =====================================================
# 2. www i inne hosty → roder.com.pl
# =====================================================
RewriteCond %{HTTP_HOST} !^roder\.com\.pl$ [NC]
RewriteRule ^(.*)$ https://roder.com.pl/$1 [R=301,L]

# =====================================================
# 3. Usunięcie index.html
# =====================================================
RewriteCond %{THE_REQUEST} \s/index\.html [NC]
RewriteRule ^index\.html$ https://roder.com.pl/ [R=301,L]

# =====================================================
# 4. Blokada dostępu do .htaccess
# =====================================================
<Files ".htaccess">
    Require all denied
</Files>

# =====================================================
# 5. Wyłączenie listowania katalogów
# =====================================================
Options -Indexes

# =====================================================
# 6. Kompresja GZIP
# =====================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff font/ttf
</IfModule>

# =====================================================
# 7. Cache
# =====================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                "access plus 1 hour"
    ExpiresByType text/css                 "access plus 1 month"
    ExpiresByType application/javascript   "access plus 1 month"
    ExpiresByType application/pdf          "access plus 1 month"
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
</IfModule>

# =====================================================
# 8. Nagłówki bezpieczeństwa
# =====================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>